# Based on https://github.com/google/googletest/tree/master/googletest#incorporating-into-an-existing-cmake-project
cmake_minimum_required(VERSION 3.5)

project(googletest-download NONE)

include(ExternalProject)
ExternalProject_Add(googletest
        GIT_REPOSITORY    https://github.com/google/googletest.git
        # Characterized by the native and sanitizer baselines. Update this
        # digest deliberately alongside the test-compatibility evidence.
        GIT_TAG           b2b9072ecbe874f5937054653ef8f2731eb0f010
        SOURCE_DIR        "${CMAKE_BINARY_DIR}/googletest-src"
        BINARY_DIR        "${CMAKE_BINARY_DIR}/googletest-build"
        CONFIGURE_COMMAND ""
        BUILD_COMMAND     ""
        INSTALL_COMMAND   ""
        TEST_COMMAND      ""
        )
